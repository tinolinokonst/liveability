# Liveability — environment variables (names only, never commit real values)
#
# Rule: only variables that are safe to publish may carry the NEXT_PUBLIC_ prefix.
# Next.js inlines NEXT_PUBLIC_* values into the client bundle, so anything secret
# must NOT use it.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public: the anon key is designed to be exposed; row access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: bypasses RLS. Server-side only (delete-account route + rate-limit guard).
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Maps ──────────────────────────────────────────────────────────────
# SECRET: server-side only (Geocoding API + Solar API).
# Restrict in Google Cloud to IP / no-referrer, and to those two APIs only.
GOOGLE_MAPS_SERVER_KEY=
# Public by necessity (Maps JS + Places autocomplete run in the browser).
# MUST be restricted by HTTP referrer in Google Cloud, or it can be lifted and billed to you.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ── Anthropic (AI Match) ─────────────────────────────────────────────────────
# SECRET: server-side only.
ANTHROPIC_API_KEY=

# ── Feature flags (server-side; "true" to enable, anything else = off) ───────
# US coverage: US addresses in autocomplete and geocoding, plus the copy that
# claims US coverage. Session 1 resolves addresses + Census FIPS only.
US_ENABLED=
# FOPH radon map card (needs FOPH's sign-off on screenshots first).
RADON_ENABLED=

# ── US data providers (added from US Session 2 on) ───────────────────────────
# All SECRET: server-side only. NEVER prefix any of these with NEXT_PUBLIC_.
# The Census Geocoder (state/county/tract FIPS) needs no key.
CENSUS_API_KEY=
AIRNOW_API_KEY=
AQS_EMAIL=
AQS_API_KEY=
DATA_GOV_API_KEY=
HUD_API_TOKEN=
FCC_USERNAME=
FCC_API_TOKEN=
MOBILITY_DB_REFRESH_TOKEN=

# ── Construction watch ───────────────────────────────────────────────────────
# SECRET: server-side only.
CRON_SECRET=
RESEND_API_KEY=
# Optional; the domain must be verified in Resend.
# EMAIL_FROM=Liveability <alerts@liveability.live>

# Optional, `next dev` only: pretend the visitor is in this country (e.g. US)
# to preview the US waitlist banner. Vercel sets the real value in production.
# DEV_VISITOR_COUNTRY=US
