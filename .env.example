# Liveability — environment variables (names only, never commit real values)
#
# Rule: only variables that are safe to publish may carry the NEXT_PUBLIC_ prefix.
# Next.js inlines NEXT_PUBLIC_* values into the client bundle, so anything secret
# must NOT use it.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public: the anon key is designed to be exposed; row access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: bypasses RLS. Server-side only (delete-account route + rate-limit guard).
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Maps ──────────────────────────────────────────────────────────────
# SECRET: server-side only (Geocoding API + Solar API).
# Restrict in Google Cloud to IP / no-referrer, and to those two APIs only.
GOOGLE_MAPS_SERVER_KEY=
# Public by necessity (Maps JS + Places autocomplete run in the browser).
# MUST be restricted by HTTP referrer in Google Cloud, or it can be lifted and billed to you.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ── Anthropic (AI Match) ─────────────────────────────────────────────────────
# SECRET: server-side only.
ANTHROPIC_API_KEY=

# ── Rentcast (US only — unused on the Swiss deployment) ──────────────────────
# SECRET: server-side only. Reachable only when NEXT_PUBLIC_DEPLOY_REGION=us.
RENTCAST_API_KEY=

# ── Deployment region ────────────────────────────────────────────────────────
# Not a secret. Unset (or anything other than "us") = Swiss deployment,
# which gates off the Rentcast integration.
NEXT_PUBLIC_DEPLOY_REGION=

# Note: the former CENSUS / DATA_GOV keys were removed in the 2026-07-31 security
# review along with the dead US-era routes that used them. If NEXT_PUBLIC_CENSUS_API_KEY
# or NEXT_PUBLIC_DATA_GOV_API_KEY are still set in your hosting provider, delete them.
