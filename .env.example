# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps
# Server-side only (geocoding, solar/sunlight API routes) — must NOT be prefixed with NEXT_PUBLIC_
GOOGLE_MAPS_SERVER_KEY=
# Client-side only (Maps JS script loader, restricted by HTTP referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Census Bureau API (optional — used for demographic data)
CENSUS_API_KEY=
NEXT_PUBLIC_CENSUS_API_KEY=

# Data.gov / FBI Crime Data Explorer API
NEXT_PUBLIC_DATA_GOV_API_KEY=

# Rentcast API
RENTCAST_API_KEY=

# Anthropic API (AI Match feature)
ANTHROPIC_API_KEY=
